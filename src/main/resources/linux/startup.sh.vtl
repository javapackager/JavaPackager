#!/usr/bin/env bash
# GNU/Linux startup script generated by JavaPackager plugin

SCRIPTPATH=$(dirname "$(readlink -e "$0")")

#if ($info.bundleJre)
JAVA="$SCRIPTPATH/${info.jreDirectoryName}/bin/java"
#else
function showMessage() {
	if type -p notify-send; then
		notify-send -u critical "${info.name}" "$1"
	else
		echo "$1"
	fi
}
if type -p java > /dev/null; then
    JAVA=java
elif [[ -n "$JAVA_HOME" ]] && [[ -x "$JAVA_HOME/bin/java" ]];  then
    JAVA="$JAVA_HOME/bin/java"
else
    showMessage "Java not installed"
    exit 1
fi
#if ($info.jreMinVersion)
#[[function compareVersions() {
        # numeric comparison of each part's leading digits (e.g. 0_392 -> 0, 17-ea -> 17); Java 8 and older report 1.x, compared as x
        local IFS=.
        local i a b v1 v2
        read -r -a v1 <<< "$1"
        read -r -a v2 <<< "$2"
        [[ ${#v1[@]} -gt 1 && "${v1[0]}" == "1" ]] && v1=("${v1[@]:1}")
        [[ ${#v2[@]} -gt 1 && "${v2[0]}" == "1" ]] && v2=("${v2[@]:1}")
        for ((i=0; i<${#v1[@]} || i<${#v2[@]}; i++))
        do
                a=${v1[i]%%[^0-9]*}
                b=${v2[i]%%[^0-9]*}
                (( 10#${a:-0} > 10#${b:-0} )) && return 0
                (( 10#${a:-0} < 10#${b:-0} )) && return 1
        done
        return 0
}]]#
JAVA_VERSION=$("$JAVA" -version 2>&1 | awk -F '"' '/version/ {print $2}')
if ! compareVersions "$JAVA_VERSION" "${info.jreMinVersion}"; then
    showMessage "The application requires a Java Runtime Environment ${info.jreMinVersion} or higher."
    exit 1
fi
#end
#end

#if ($info.linuxConfig.wrapJar)
BINARY="$SCRIPTPATH/${info.executable.name}"
#else
BINARY="$SCRIPTPATH/${info.jarFile.name}"
#end

#if ($info.envPath)
export PATH=${info.envPath}
#end

JVMDefaultOptions=()
#foreach ($vmArg in $info.vmArgs)
JVMDefaultOptions+=("$vmArg")
#end

JVMOptionsFile="$SCRIPTPATH/${info.name}.l4j.ini"
#[[[ -f "${JVMOptionsFile}" ] && while read -r -a option; do JVMDefaultOptions+=("${option[@]}"); done <<< "$(sed -e "/^#.*$/d" -e "/^[[:space:]]*$/d" "${JVMOptionsFile}")"]]#

#if ($info.classpath)
# -jar ignores any other classpath: with extra entries, run the main class (the JAR manifest's Class-Path still applies)
JVMClassPath="$BINARY"
#foreach ($classpath in $info.classpaths)
JVMClassPath+=":${classpath}"
#end
JVMLaunch=(-cp "$JVMClassPath" "${info.mainClass}")
#else
JVMLaunch=(-jar "$BINARY")
#end

AppArguments=()
#foreach ($appArg in $info.appArgs)
AppArguments+=("$appArg")
#end

#if ($info.useResourcesAsWorkingDir)
cd "$SCRIPTPATH" || exit 1
#end

#if ($info.scripts.bootstrap)
# invoke bootstrap script
Bootstrap="$SCRIPTPATH/scripts/${info.bootstrapFile.name}" && [ -x "$Bootstrap" ] && "$Bootstrap"
#end

#if ($info.administratorRequired)
#[[exec pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" GDK_BACKEND=x11 "${JAVA}" "${JVMDefaultOptions[@]}" "${JVMLaunch[@]}" "${AppArguments[@]}" "$@"]]#
#else
#[[exec "${JAVA}" "${JVMDefaultOptions[@]}" "${JVMLaunch[@]}" "${AppArguments[@]}" "$@"]]#
